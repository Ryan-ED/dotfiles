#!/usr/bin/env bash
{{- /* Only runs for machineClass=bazzite. Bazzite is an atomic/ostree image, and Nix's
   installer (which devbox pulls in) is known to be fragile on ostree hosts - it wants to
   write /nix and manage /etc/{bashrc,zshrc,synthetic.conf} in ways that fight rpm-ostree.
   So instead of touching the host at all, devbox+Nix live inside a Fedora Distrobox
   container named "devbox", entered on demand with `distrobox enter devbox`. */ -}}
{{- if ne .machineClass "bazzite" }}
exit 0
{{- end }}
{{- if eq .chezmoi.os "windows" }}
echo "chezmoi.os=windows: skipping Distrobox bootstrap (unsupported on native Windows)"
exit 0
{{- end }}

set -euo pipefail

# This whole script (and the initial chezmoi clone before it) runs on the bare
# Bazzite HOST, not inside the container below - so if the host shell is bash
# rather than zsh, it hits the same "chezmoi lands in ~/.local/bin, nothing
# put that on PATH" gap covered for standard/wsl in
# run_once_00-bootstrap-standard.sh.tmpl and for zsh (any machineClass) in
# dot_zshrc.tmpl. Unlike that container-scoped devbox/starship/fnm block
# further down (guarded by /run/.containerenv since those tools only exist
# inside the container), this one is intentionally unguarded - it's a plain
# PATH fix for the host shell itself.
RC_FILE="$HOME/.bashrc"
touch "$RC_FILE"
grep -qF 'export PATH="$HOME/.local/bin:$PATH"' "$RC_FILE" || \
  printf '\n# added by chezmoi (bazzite host)\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$RC_FILE"

CONTAINER_NAME="devbox"

if ! command -v distrobox >/dev/null 2>&1; then
  echo "distrobox not found on host. Install it first (Bazzite ships it by default;" >&2
  echo "otherwise: https://distrobox.it/#installation) and re-run chezmoi apply." >&2
  exit 1
fi

if ! distrobox list --no-color 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
  echo "Creating Distrobox container '${CONTAINER_NAME}' (Fedora)..."
  distrobox create --name "${CONTAINER_NAME}" --image fedora:latest --yes
fi

echo "Bootstrapping devbox+Nix inside '${CONTAINER_NAME}'..."
distrobox enter "${CONTAINER_NAME}" -- bash -c '
  set -euo pipefail
  if ! command -v devbox >/dev/null 2>&1; then
    curl -fsSL https://get.jetify.com/devbox | bash -f
  fi
  devbox global install
  RC_FILE="$HOME/.bashrc"
  touch "$RC_FILE"
  # devbox/starship/fnm only exist inside this container - $HOME (and thus .bashrc) is
  # shared with the bare Bazzite host via Distrobox, so guard on /run/.containerenv to
  # stop a plain host shell from trying to eval commands that only exist in here.
  grep -qF "added by chezmoi (bazzite devbox)" "$RC_FILE" || printf "\n# added by chezmoi (bazzite devbox)\nif [ -f /run/.containerenv ]; then\n  eval \"\$(devbox global shellenv)\"\n  eval \"\$(starship init bash)\"\n  eval \"\$(fnm env --use-on-cd)\"\nfi\n" >> "$RC_FILE"
'

echo "devbox is ready inside the '${CONTAINER_NAME}' container."
echo "Enter it with: distrobox enter ${CONTAINER_NAME}"
echo "To expose a specific binary on the host PATH: distrobox-export --bin /path/in/container/to/bin"

{{- /* Distrobox shares $HOME between host and container, so devbox's Nix-installed fonts
   (installed above, inside the container) already exist at this path on the host's own
   disk too - but the HOST's fontconfig was never told to look there (that only happened,
   if at all, inside the container's own shell config, which the host never sources). This
   registers it on the actual host, where a Flatpak/native WezTerm install actually runs. */ -}}
DEVBOX_FONTS_DIR="$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default/share/fonts"
FONTCONFIG_FILE="$HOME/.config/fontconfig/fonts.conf"
mkdir -p "$(dirname "$FONTCONFIG_FILE")"
if [ ! -f "$FONTCONFIG_FILE" ]; then
  cat > "$FONTCONFIG_FILE" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <dir>$DEVBOX_FONTS_DIR</dir>
</fontconfig>
EOF
  echo "Created $FONTCONFIG_FILE registering devbox's font directory (on host)"
elif ! grep -qF "$DEVBOX_FONTS_DIR" "$FONTCONFIG_FILE"; then
  sed -i "s#</fontconfig>#  <dir>$DEVBOX_FONTS_DIR</dir>\n</fontconfig>#" "$FONTCONFIG_FILE"
  echo "Added devbox's font directory to existing $FONTCONFIG_FILE (on host)"
fi
if command -v fc-cache >/dev/null 2>&1; then
  fc-cache -f >/dev/null 2>&1 || true
else
  echo "fc-cache not found on host - fonts registered but cache not rebuilt yet" >&2
fi
