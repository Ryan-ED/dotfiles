#!/usr/bin/env bash
{{- /* Skipped entirely on Bazzite: Nix has known install issues on ostree/atomic hosts,
   so that machine class gets its devbox+Nix inside a Distrobox container instead
   (see run_once_00-bootstrap-bazzite.sh.tmpl). "standard" and "wsl" both bootstrap
   directly on the host here. */ -}}
{{- if eq .machineClass "bazzite" }}
echo "machineClass=bazzite: skipping host bootstrap, see bootstrap-bazzite script"
exit 0
{{- end }}
{{- /* devbox/Nix aren't supported on native Windows. If chezmoi is ever applied there
   directly (e.g. so WezTerm's native config gets deployed for machineClass=wsl), skip
   the devbox bootstrap entirely - only WSL/Linux/macOS get it. */ -}}
{{- if eq .chezmoi.os "windows" }}
echo "chezmoi.os=windows: skipping devbox bootstrap (unsupported on native Windows), only deploying plain dotfiles"
exit 0
{{- end }}

set -euo pipefail

if ! command -v devbox >/dev/null 2>&1; then
  echo "Installing devbox (this also bootstraps Nix)..."
  curl -fsSL https://get.jetify.com/devbox | bash
fi

echo "Installing global devbox packages..."
devbox global install

append_once() {
  local rc_file="$1" line="$2"
  [ -f "$rc_file" ] || touch "$rc_file"
  if ! grep -qF "$line" "$rc_file"; then
    printf '\n# added by chezmoi\n%s\n' "$line" >> "$rc_file"
    echo "Added '$line' to $rc_file"
  fi
}

# devbox shellenv must load first - starship and fnm are themselves devbox packages
# and need to already be on PATH before their own init/hook commands can run.
append_once "$HOME/.bashrc" 'eval "$(devbox global shellenv)"'
append_once "$HOME/.bashrc" 'eval "$(starship init bash)"'
append_once "$HOME/.bashrc" 'eval "$(fnm env --use-on-cd)"'

if [ -n "${ZSH_VERSION:-}" ] || command -v zsh >/dev/null 2>&1; then
  append_once "$HOME/.zshrc" 'eval "$(devbox global shellenv)"'
  append_once "$HOME/.zshrc" 'eval "$(starship init zsh)"'
  append_once "$HOME/.zshrc" 'eval "$(fnm env --use-on-cd)"'

  # devbox's stable global-profile path (same one `which starship` resolves through).
  DEVBOX_PROFILE="$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default"
  append_once "$HOME/.zshrc" "source $DEVBOX_PROFILE/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  # zsh-syntax-highlighting must be the LAST thing sourced in .zshrc (its own
  # requirement - anything sourced after it can silently break the highlighting).
  append_once "$HOME/.zshrc" "source $DEVBOX_PROFILE/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

echo "devbox bootstrap complete. Open a new shell (or 'exec $SHELL') to pick up global packages."
